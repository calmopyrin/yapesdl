objects =		\
1541mem.o \
archdep.o		\
Cia.o		\
cpu.o	\
dis.o	\
diskfs.o \
dos.o \
drive.o \
emu2149.o \
FdcGcr.o \
iec.o \
interface.o		\
keyboard.o \
keys64.o \
keysvic.o \
main.o \
monitor.o 	\
OPL2Sound.o \
opl3.o \
prg.o \
SaveState.o	\
serial.o	\
Sid.o \
sound.o	\
tape.o \
tcbm.o \
tedmem.o \
tedsound.o \
Via.o \
vicmem.o \
vic2mem.o \
video.o \
YM2149.o

EXENAME = yapesdl
VERSION = 0.81.1-1
SRCPACKAGENAME = $(EXENAME)_$(VERSION)
DEB_ARCH := $(shell dpkg --print-architecture 2>/dev/null || echo amd64)
BINPACKAGENAME = $(SRCPACKAGENAME)_$(DEB_ARCH)

# ---------------------------------------------------------------------------
# Build options (all optional, e.g. "make NATIVE=1 LTO=1"):
#   BUILD=debug  -O0 -g3 with AddressSanitizer / UBSan, produces yapesdld
#   NATIVE=1     tune for this machine (-march=native); never use for "make deb"
#   LTO=1        link time optimisation (slower link, usually a little faster)
#   PREFIX=...   install prefix, default /usr/local ("make deb" always uses /usr)
# ---------------------------------------------------------------------------
BUILD ?= release
NATIVE ?= 0
LTO ?= 0
PREFIX ?= /usr/local
BINDIR ?= $(PREFIX)/bin
BUS_EMUL ?= 0

CXX ?= g++
SDL_CFLAGS := $(shell sdl2-config --cflags)
SDL_LDFLAGS := $(shell sdl2-config --libs)

common = -std=gnu++17 -fno-strict-aliasing -Wall -Wno-unused -Wno-sign-compare -Wno-unknown-pragmas \
         $(SDL_CFLAGS)

ifeq ($(BUS_EMUL),1)
  common += -DBUS_EMUL
endif

ifeq ($(BUILD),debug)
  TARGET = $(EXENAME)d
  cflags = $(common) -O0 -g3 -fno-omit-frame-pointer -fsanitize=address,undefined
  ldflags = -fsanitize=address,undefined
else
  TARGET = $(EXENAME)
  cflags = $(common) -O2 -fno-math-errno
  ldflags = -Wl,-z,relro -Wl,-z,now
  ifeq ($(NATIVE),1)
    cflags += -march=native
  else
    cflags += -mtune=generic
  endif
  ifeq ($(LTO),1)
    cflags += -flto=auto
    ldflags += -flto=auto
  endif
endif

# header dependencies are generated by the compiler (*.d files)
depflags = -MMD -MP
libs = $(SDL_LDFLAGS)

headers = $(objects:.o=.h)
sources = $(objects:.o=.cpp)
allfiles = $(headers) $(sources)
hasnoheader = main.h dos.h dis.h tedsound.h
sourcefiles = $(filter-out $(hasnoheader),$(allfiles)) icon.h device.h mem.h mnemonic.h \
				roms.h types.h Clockable.h 1541rom.h YapeSDL.cbp YapeSDL.Linux.cbp

.PHONY : all yape yapedebug clean tgz e deb install FORCE

all : yape

yape : $(TARGET)

yapedebug :
	$(MAKE) BUILD=debug yape

$(TARGET) : $(objects)
	$(CXX) $(cflags) $(ldflags) -o $@ $(objects) $(libs)

# objects are rebuilt whenever the compiler flags change
.cflags : FORCE
	@echo '$(CXX) $(cflags)' | cmp -s - $@ || echo '$(CXX) $(cflags)' > $@

$(objects) : .cflags

%.o : %.cpp
	$(CXX) $(cflags) $(depflags) -c $<

# third party sources living in sub directories
emu2149.o : ym2149/emu2149.c
	$(CXX) $(cflags) $(depflags) -x c++ -c $< -o $@

opl3.o : opl3/opl3.c
	$(CXX) $(cflags) $(depflags) -x c++ -c $< -o $@

-include $(objects:.o=.d)

clean :
	rm -f ./*.o ./*.d ./.cflags
	rm -f ./$(EXENAME) ./$(EXENAME)d
	rm -rf ./deb-build

tgz :
	tar -czf $(SRCPACKAGENAME).tar.gz $(sourcefiles) Makefile COPYING README.SDL Changes

e :
	#emacs -fn 9x13 Makefile *.h *.cpp &
	emacs -fn 10x20 Makefile *.h *.cpp &

# Debian package: always a portable (no -march=native, no LTO) build under /usr
deb :
	$(MAKE) BUILD=release NATIVE=0 LTO=0 yape
	rm -rf deb-build
	install -d deb-build/$(SRCPACKAGENAME)/DEBIAN \
		deb-build/$(SRCPACKAGENAME)/usr/bin \
		deb-build/$(SRCPACKAGENAME)/usr/share/doc/$(EXENAME)
	install -m 0755 $(EXENAME) deb-build/$(SRCPACKAGENAME)/usr/bin/$(EXENAME)
	strip --strip-unneeded deb-build/$(SRCPACKAGENAME)/usr/bin/$(EXENAME)
	install -m 0644 $(SRCPACKAGENAME)/DEBIAN/copyright deb-build/$(SRCPACKAGENAME)/usr/share/doc/$(EXENAME)/copyright
	install -m 0644 README.SDL deb-build/$(SRCPACKAGENAME)/usr/share/doc/$(EXENAME)/
	gzip -9n -c Changes > deb-build/$(SRCPACKAGENAME)/usr/share/doc/$(EXENAME)/changelog.gz
	chmod 0644 deb-build/$(SRCPACKAGENAME)/usr/share/doc/$(EXENAME)/changelog.gz
	sed -e 's/^Architecture:.*/Architecture: $(DEB_ARCH)/' \
	    -e 's/^Version:.*/Version: $(VERSION)/' \
	    -e '/^Installed-Size:/d' $(SRCPACKAGENAME)/DEBIAN/control > deb-build/$(SRCPACKAGENAME)/DEBIAN/control
	sed -i "/^Depends:/i Installed-Size: $$(du -sk deb-build/$(SRCPACKAGENAME)/usr | cut -f1)" deb-build/$(SRCPACKAGENAME)/DEBIAN/control
	dpkg-deb --root-owner-group --build deb-build/$(SRCPACKAGENAME) $(BINPACKAGENAME).deb

install : yape
	install -d $(DESTDIR)$(BINDIR)
	install -m 0755 $(EXENAME) $(DESTDIR)$(BINDIR)/$(EXENAME)
